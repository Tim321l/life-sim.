{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "buildCommand": "bash build_vercel.sh",
  "outputDirectory": "publish/wwwroot",
  "rewrites": [
    {
      "source": "/((?!css|js|data|_framework|_content|lib|favicon\\.png|icon-192\\.png).*)",
      "destination": "/index.html"
    }
  ]
}
