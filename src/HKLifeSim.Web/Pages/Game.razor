                                        <div class="country-selector">
                                            <button type="button" class="primary-button" style="min-height:32px; font-size:0.8rem;" disabled="@(remainingHangouts <= 0 || Session.IsBusy)" @onclick="() => HangOutWithNpcAsync(npc.Key)">💬 相處</button>
                                            <button type="button" class="primary-button" style="min-height:32px; font-size:0.8rem;" disabled="@(Session.State.FlagsSet.Count(f => f.StartsWith($"action_chat_{npc.Key}_", StringComparison.Ordinal)) >= 3 || Session.IsBusy)" @onclick="() => ChatWithNpcAsync(npc.Key)">🗨️ 傾計</button>
