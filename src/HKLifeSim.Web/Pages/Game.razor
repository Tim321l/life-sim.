                            <div class="action-card">
                                <div class="action-card-header">
                                    <span class="action-card-title">與家人同樂 Family Time</span>
                                    <span class="action-card-limit">@(Session.State.HasFlag("action_family_chat") ? "0/1" : "1/1")</span>
                                </div>
                                <p class="action-card-desc">陪伴家人聊天吃飯，增進親情，減輕壓力。</p>
                                <p class="action-card-effects">親情 +8 · 壓力 -3</p>
                                <button type="button" class="primary-button action-button" disabled="@(Session.State.HasFlag("action_family_chat") || Session.IsBusy)" @onclick="SpendFamilyTimeAsync">👪 陪屋企人 Chat</button>
                            </div>

                            <!-- Buy gift for Family -->
                            <div class="action-card">
                                <div class="action-card-header">
                                    <span class="action-card-title">給家人送禮 Buy Family Gift</span>
                                    @{
                                        var familyGiftCount = Session.State.FlagsSet.Count(f => f.StartsWith("action_family_gift_", StringComparison.Ordinal));
                                        var remainingFamilyGifts = 2 - familyGiftCount;
                                    }
                                    <span class="action-card-limit">@remainingFamilyGifts/2</span>
                                </div>
                                <p class="action-card-desc">給家人買一份禮物表達心意，極大提升親情。</p>
                                <p class="action-card-effects cost">親情 +15 · 壓力 -2 · 金錢 -$@FormatAmount(Session.ScaleMoney(1000))</p>
                                <button type="button" class="primary-button action-button" disabled="@(remainingFamilyGifts <= 0 || Session.State.Stats.Money < Session.ScaleMoney(1000) || Session.IsBusy)" @onclick="BuyFamilyGiftAsync">🎁 送禮物 Gift</button>
                            </div>

                            @if (Session.State.Age >= 16)
                            {
                                <!-- Relationship logic (16+) -->
                                @if (!Session.State.HasFlag("has_partner"))
                                {
                                    <div class="action-card">
                                        <div class="action-card-header">
                                            <span class="action-card-title">尋找伴侶 Find Love</span>
                                            @{
                                                var partnerFindCount = Session.State.FlagsSet.Count(f => f.StartsWith("action_partner_find_", StringComparison.Ordinal));
                                                var remainingPartnerFinds = 2 - partnerFindCount;
                                            }
                                            <span class="action-card-limit">@remainingPartnerFinds/2</span>
                                        </div>
                                        <p class="action-card-desc">約會心儀對象並嘗試表白出Pool！(成功率 50%)</p>
                                        <p class="action-card-effects">有機會獲得伴侶狀態</p>
                                        <button type="button" class="primary-button action-button" disabled="@(remainingPartnerFinds <= 0 || Session.IsBusy)" @onclick="FindPartnerAsync">💖 表白出Pool Propose</button>
                                    </div>
                                }
