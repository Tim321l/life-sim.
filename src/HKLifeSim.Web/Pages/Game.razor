                                    var remainingHangouts = 2 - hangoutCount;
                                    var friendshipLevel = Session.GetFriendshipLevel(npc.Key);
                                    var friendshipTier = HKLifeSim.Web.Services.GameSessionService.FriendshipTierLabel(friendshipLevel);
                                    var friendshipPercent = HKLifeSim.Web.Services.GameSessionService.FriendshipPercent(friendshipLevel);
                                    <div class="action-card">
