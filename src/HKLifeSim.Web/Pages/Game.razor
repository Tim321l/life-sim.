                                        @if (Session.State.HasFlag("home_private"))
                                        {
                                            <div class="property-status">持有中 Owned</div>
                                        }
                                    </div>
                                    <div class="property-actions">
                                        @if (Session.State.HasFlag("home_private"))
                                        {
                                            <button type="button" class="primary-button action-btn" style="background:var(--stress); border-color:var(--stress); color:#fff;" disabled="@Session.IsBusy" @onclick='() => SellPropertyAsync("private")'>賣出 Sell</button>
                                        }
                                        else
                                        {
                                            <button type="button" class="primary-button action-btn" disabled="@(Session.State.HasFlag("homeowner") || Session.State.Stats.Money < (int)(Session.Era?.AverageHousePrice ?? 0m) || Session.IsBusy)" @onclick='() => BuyPropertyAsync("private")'>購買 Buy</button>
                                        }
