    // Trivia Questions Methods
    private string GetTriviaQuestion(int qIndex)
    {
        if (Session.State is null) return string.Empty;
        var isScience = Session.State.HasFlag("stream_science");
        var isBusiness = Session.State.HasFlag("stream_business");
        var isArts = Session.State.HasFlag("stream_arts");

        if (isScience)
        {
            return qIndex == 1 
                ? "中學物理：萬有引力定律係由邊位科學家提出？" 
                : "中學化學：水分子 (Water) 嘅基本化學分子式係？";
        }
        else if (isBusiness)
        {
            return qIndex == 1
                ? "中學經濟：在供求定律中，當市場需求增加而供應不變時，均衡價格會？"
                : "中學會計：本金$10,000，年利率10%以複利計算，兩年後的本利和為？";
        }
        else if (isArts)
        {
            return qIndex == 1
                ? "中學歷史：清朝政府與英國簽署《南京條約》，香港島是在哪一年開埠？"
                : "中學文學：三國演義中，「桃園三結義」是指劉備、關羽與哪位將領？";
        }
        else
        {
            return qIndex == 1
                ? "香港常識：香港特別行政區成立於哪一年？"
                : "地理常識：香港地標「獅子山」座落於邊兩個地區之分界？";
        }
    }

    private string GetTriviaOption(int qIndex, int optionIndex)
    {
        if (Session.State is null) return string.Empty;
        var isScience = Session.State.HasFlag("stream_science");
        var isBusiness = Session.State.HasFlag("stream_business");
        var isArts = Session.State.HasFlag("stream_arts");

        if (isScience)
        {
            if (qIndex == 1)
            {
                return optionIndex switch { 0 => "牛頓 Isaac Newton", 1 => "愛因斯坦 Albert Einstein", _ => "伽利略 Galileo Galilei" };
            }
            else
            {
                return optionIndex switch { 0 => "H2O", 1 => "CO2", _ => "NaCl" };
            }
        }
        else if (isBusiness)
        {
            if (qIndex == 1)
            {
                return optionIndex switch { 0 => "上升 Rise", 1 => "下跌 Fall", _ => "維持不變 Unchanged" };
            }
            else
            {
                return optionIndex switch { 0 => "$12,100", 1 => "$12,000", _ => "$11,000" };
            }
        }
        else if (isArts)
        {
            if (qIndex == 1)
            {
                return optionIndex switch { 0 => "1841 年", 1 => "1911 年", _ => "1997 年" };
            }
            else
            {
                return optionIndex switch { 0 => "張飛 Zhang Fei", 1 => "趙雲 Zhao Yun", _ => "諸葛亮 Zhuge Liang" };
            }
        }
        else
        {
            if (qIndex == 1)
            {
                return optionIndex switch { 0 => "1997 年", 1 => "1984 年", _ => "2003 年" };
            }
            else
            {
                return optionIndex switch { 0 => "九龍與新界之間", 1 => "港島南部", _ => "大嶼山及長洲" };
            }
        }
    }

    private void OnSessionChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => Session.Changed -= OnSessionChanged;
