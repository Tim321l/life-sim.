                                            <span class="action-card-title">與伴侶約會 Date @(partnerInfo is not null ? partnerInfo.Value.Name : "Partner")</span>
                                            @{
                                                var partnerDateCount = Session.State.FlagsSet.Count(f => f.StartsWith("action_partner_date_", StringComparison.Ordinal));
                                                var remainingPartnerDates = 2 - partnerDateCount;
                                            }
                                            <span class="action-card-limit">@remainingPartnerDates/2</span>
                                        </div>
