@page "/game"
@inject GameSessionService Session
@inject NavigationManager Nav
@implements IDisposable

@if (Session.State is not null)
{
    <!-- Phase A: Milestone Overlay Modal -->
    @if (_activeMilestone is not null)
    {
        <div class="event-overlay">
            <div class="glass-panel event-card" style="border-color: var(--reputation); box-shadow: 0 0 25px var(--reputation-glow);">
                <div class="event-year-age" style="color: var(--reputation); font-weight: bold; font-size: 1rem;">
                    🏆 人生里程碑 Milestone
                </div>
                <h2 class="event-title" style="margin-bottom: 24px; font-size: 1.8rem;">放榜與派位結果</h2>
                <p class="event-body" style="font-size: 1.2rem; font-weight: 500; text-align: left; padding: 20px; background: rgba(255,255,255,0.02); border-radius: 10px; border-left: 4px solid var(--reputation); line-height: 1.6;">
                    @_activeMilestone
                </p>
                <div style="margin-top: 32px;">
                    <button type="button" class="primary-button action-btn" style="min-width: 160px;" @onclick="ClearMilestone">收到！ Confirm</button>
                </div>
            </div>
        </div>
    }

    <!-- Phase A: DSE Stream Chooser Modal -->
    @if (IsStreamSelectionRequired)
    {
        <div class="event-overlay">
            <div class="glass-panel event-card" style="border-color: var(--accent); box-shadow: 0 0 25px var(--accent-glow);">
                <div class="event-year-age" style="color: var(--accent); font-weight: bold;">
                    ✏️ 中四選科 Stream Selection
                </div>
                <h2 class="event-title">選擇你嘅選修科 Stream</h2>
                <p class="event-body" style="line-height: 1.5;">
                    升讀中四，你需要選擇未來兩年嘅選修學科。選科會影響你 DSE 嘅加分試題目！
                </p>
                <div class="event-choices" style="display:flex; flex-direction:column; gap:12px; margin-top:20px;">
                    <button type="button" class="choice-button" @onclick='() => ChooseStream("science")'>
                        🧪 理科 Science (物理 Physics + 化學 Chemistry)
                    </button>
                    <button type="button" class="choice-button" @onclick='() => ChooseStream("business")'>
                        📈 商科 Business (經濟 Economics + BAFS 企會財)
                    </button>
                    <button type="button" class="choice-button" @onclick='() => ChooseStream("arts")'>
                        📜 文科 Arts (歷史 History + 中國文學)
                    </button>
                </div>
            </div>
        </div>
    }

    <!-- Phase A: College Path Chooser Modal -->
    @if (IsCollegeSelectionRequired)
    {
        <div class="event-overlay">
            <div class="glass-panel event-card" style="border-color: var(--education); box-shadow: 0 0 25px var(--education-glow);">
                <div class="event-year-age" style="color: var(--education); font-weight: bold;">
                    🎓 大專路向選擇 College Path
                </div>
                <h2 class="event-title">選擇你嘅專上學位</h2>
                <p class="event-body" style="line-height: 1.5;">
                    JUPAS 分配你入讀副學位課程。請選擇就讀方向（大專兩年如果學歷達 60% 即可 Non-JUPAS 銜接大學）：
                </p>
                <div class="event-choices" style="display:flex; flex-direction:column; gap:12px; margin-top:20px;">
                    <button type="button" class="choice-button" @onclick='() => ChooseCollege("asso")'>
                        🎨 副學士課程 (Associate Degree) - 側重學術，為銜接大學學位做準備
                    </button>
                    <button type="button" class="choice-button" @onclick='() => ChooseCollege("hd")'>
                        💻 高級文憑課程 (Higher Diploma) - 側重專業技術，為就業/銜接學位雙軌準備
                    </button>
                </div>
            </div>
        </div>
    }

    <!-- Phase A: Exam Trivia Modal -->
    @if (_showExamTrivia)
    {
        <div class="event-overlay">
            <div class="glass-panel event-card" style="max-width: 600px; border-color: var(--reputation); box-shadow: 0 0 25px var(--reputation-glow);">
                <div class="event-year-age" style="color: var(--reputation); font-weight: bold;">
                    📝 畢業試加分題 Exam Trivia
                </div>
                <h2 class="event-title" style="font-size:1.5rem;">香港公開考試 (HKDSE/會考)</h2>
                <p class="event-body" style="font-size:0.95rem; line-height:1.5; color: var(--text-secondary); margin-bottom: 12px;">
                    你即將步入試場！作答選修學科考題。答對將直接提升你的最終成績點數！
                </p>

                <div class="trivia-questions" style="text-align: left; background: rgba(0,0,0,0.2); padding: 16px; border-radius: 8px;">
                    <!-- Question 1 -->
                    <div style="margin-bottom: 16px;">
                        <p style="font-weight: bold; margin-bottom: 6px; font-size:0.95rem;">Q1: @GetTriviaQuestion(1)</p>
                        <select class="text-input" style="width: 100%; min-height:36px; padding:4px;" @bind="_triviaQ1Answer">
                            <option value="-1">-- 請選擇答案 --</option>
                            <option value="0">@GetTriviaOption(1, 0)</option>
                            <option value="1">@GetTriviaOption(1, 1)</option>
                            <option value="2">@GetTriviaOption(1, 2)</option>
                        </select>
                    </div>

                    <!-- Question 2 -->
                    <div>
                        <p style="font-weight: bold; margin-bottom: 6px; font-size:0.95rem;">Q2: @GetTriviaQuestion(2)</p>
                        <select class="text-input" style="width: 100%; min-height:36px; padding:4px;" @bind="_triviaQ2Answer">
                            <option value="-1">-- 請選擇答案 --</option>
                            <option value="0">@GetTriviaOption(2, 0)</option>
                            <option value="1">@GetTriviaOption(2, 1)</option>
                            <option value="2">@GetTriviaOption(2, 2)</option>
                        </select>
                    </div>
                </div>

                @if (_triviaError is not null)
                {
                    <p style="color: var(--stress); font-size: 0.9rem; margin-top: 8px; font-weight: bold;">@_triviaError</p>
                }

                <div style="margin-top: 20px;">
                    <button type="button" class="primary-button action-btn" style="min-width: 150px;" @onclick="SubmitExamTrivia">✍️ 遞交答卷 Submit</button>
                </div>
            </div>
        </div>
    }

    <!-- Phase A: Annual Event Overlay/Modal (if current event is active) -->
    @if (Session.CurrentEvent is not null)
    {
        <div class="event-overlay">
            <div class="glass-panel event-card">
                <div class="event-year-age">
                    @Session.State.CurrentYear 年 · 現年 @Session.State.Age 歲
                </div>
                
                @if (Session.CurrentEvent.Id.StartsWith("generic_daily_life_", StringComparison.Ordinal) && Session.State.Age < 18)
                {
                    <h2 class="event-title">@GetChildhoodEventTitle()</h2>
                    <p class="event-body">@GetChildhoodEventBody(Session.State.Age)</p>

                    <div class="event-choices">
                        @foreach (var choice in Session.CurrentEvent.Choices)
                        {
                            <button type="button"
                                    class="choice-button"
                                    disabled="@Session.IsBusy"
                                    @onclick="() => SelectChoiceAsync(choice.Id)">
                                @GetChildhoodChoiceText(choice.Id, Session.State.Age)
                            </button>
                        }
                    </div>
                }
                else
                {
                    <h2 class="event-title">@Session.CurrentEvent.Title</h2>
                    <p class="event-body">@Session.CurrentEvent.Body</p>

                    <div class="event-choices">
                        @foreach (var choice in Session.CurrentEvent.Choices)
                        {
                            <button type="button"
                                    class="choice-button"
                                    disabled="@Session.IsBusy"
                                    @onclick="() => SelectChoiceAsync(choice.Id)">
                                @choice.Text
                            </button>
                        }
                    </div>
                }
            </div>
        </div>
    }

    <!-- Phase B: Active Actions Dashboard (displayed when event is resolved) -->
    <div class="game-page">
        <!-- Floating notification for stat deltas -->
        @if (!string.IsNullOrEmpty(Session.StatDeltaToast))
        {
            <div class="toast-banner">
                <div>⚡ 屬性變動 Stat Changes:</div>
                <div class="stat-deltas-highlight">@Session.StatDeltaToast</div>
            </div>
        }

        @if (_actionFeedback is not null)
        {
            <div class="toast-banner">
                <div>@_actionFeedback</div>
            </div>
        }

        <!-- Top Stat Bar -->
        <div class="glass-panel">
            <StatBar Stats="Session.State.Stats" />
        </div>

        <div class="game-layout">
            <!-- Left column: Profile & Stats info -->
            <div class="sidebar-panel">
                <div class="glass-panel profile-card">
                    <h3 class="section-title">👤 角色檔案 Profile</h3>
                    <div class="profile-name" style="margin-bottom:4px;">
                        @(Session.State.Profile?.Name ?? "香港仔")
                    </div>
                    <div class="profile-meta">
                        @(Session.State.Profile?.Gender switch {
                            Gender.Male => "👦 仔 Male",
                            Gender.Female => "👧 女 Female",
                            _ => "🤖 其他 Other"
                        })
                    </div>
                    
                    <!-- Family background badge -->
                    <div style="margin-top:8px;">
                        @if (Session.State.HasFlag("family_poor"))
                        {
                            <span class="flag-chip" style="background: rgba(231, 76, 60, 0.15); border-color: #e74c3c; color: #ff7675; font-weight: bold; width: 100%; display: inline-block; text-align: center;">🏚️ 基層貧困家庭 Poor</span>
                        }
                        else if (Session.State.HasFlag("family_rich"))
                        {
                            <span class="flag-chip" style="background: rgba(46, 204, 113, 0.15); border-color: #2ecc71; color: #58db91; font-weight: bold; width: 100%; display: inline-block; text-align: center;">🏰 富裕豪門家庭 Rich</span>
                        }
                        else
                        {
                            <span class="flag-chip" style="background: rgba(52, 152, 219, 0.15); border-color: #3498db; color: #74b9ff; font-weight: bold; width: 100%; display: inline-block; text-align: center;">🏢 小康中產家庭 Middle</span>
                        }
                    </div>

                    <div class="profile-details" style="margin-top:16px;">
                        <div class="detail-row">
                            <span class="detail-label">年代 Era</span>
                            <span class="detail-val">@EraCatalog.Describe(Session.State.EraId).DisplayName</span>
                        </div>
                        <div class="detail-row">
                            <span class="detail-label">年份 Year</span>
                            <span class="detail-val">@Session.State.CurrentYear 年</span>
                        </div>
                        <div class="detail-row">
                            <span class="detail-label">年齡 Age</span>
                            <span class="detail-val">@Session.State.Age 歲</span>
                        </div>
                    </div>

                    <h4 class="flag-chips-title">🏷️ 狀態旗標 Flags</h4>
                    <div class="flag-chips">
                        @if (Session.State.FlagsSet.Count(f => !f.StartsWith("action_", StringComparison.Ordinal) && !f.StartsWith("friend_", StringComparison.Ordinal) && !f.StartsWith("npc_friend_", StringComparison.Ordinal) && !f.StartsWith("partner_", StringComparison.Ordinal) && !f.StartsWith("child_", StringComparison.Ordinal) && !f.StartsWith("skill_", StringComparison.Ordinal) && !f.StartsWith("exam_score_", StringComparison.Ordinal) && f != "event_resolved_for_year") == 0)
                        {
                            <span class="flag-chip">平平無奇 Normal</span>
                        }
                        else
                        {
                            @foreach (var flag in Session.State.FlagsSet.Where(f => !f.StartsWith("action_", StringComparison.Ordinal) && !f.StartsWith("friend_", StringComparison.Ordinal) && !f.StartsWith("npc_friend_", StringComparison.Ordinal) && !f.StartsWith("partner_", StringComparison.Ordinal) && !f.StartsWith("child_", StringComparison.Ordinal) && !f.StartsWith("skill_", StringComparison.Ordinal) && !f.StartsWith("exam_score_", StringComparison.Ordinal) && f != "event_resolved_for_year"))
                            {
                                <span class="flag-chip">@TranslateFlag(flag)</span>
                            }
                        }
                    </div>
                </div>
            </div>

            <!-- Right column: Active actions panel tabs -->
            <div class="glass-panel dashboard-panel">
                <div class="tabs-header">
                    <button type="button" class="tab-btn @(_activeTab == "home" ? "active" : string.Empty)" @onclick='() => _activeTab = "home"'>🏠 經歷 Log</button>
                    <button type="button" class="tab-btn @(_activeTab == "career" ? "active" : string.Empty)" @onclick='() => _activeTab = "career"'>📚 事業 Study/Job</button>
                    <button type="button" class="tab-btn @(_activeTab == "social" ? "active" : string.Empty)" @onclick='() => _activeTab = "social"'>👥 人際 Social</button>
                    <button type="button" class="tab-btn @(_activeTab == "assets" ? "active" : string.Empty)" @onclick='() => _activeTab = "assets"'>🏡 資產 Assets</button>
                    <button type="button" class="tab-btn @(_activeTab == "activities" ? "active" : string.Empty)" @onclick='() => _activeTab = "activities"'>🪁 活動 Activities</button>
                    <button type="button" class="tab-btn @(_activeTab == "hobbies" ? "active" : string.Empty)" @onclick='() => _activeTab = "hobbies"'>🎨 興趣 Hobbies</button>
                </div>

                <div class="tab-content">
                    @if (_activeTab == "home")
                    {
                        <h4 class="section-title">📜 人生經歷與事件日誌 Event Log</h4>
                        <div class="log-list">
                            @if (_actionLogs.Count == 0)
                            {
                                <p class="text-secondary" style="text-align:center; padding-top:40px;">今年仲未開始任何行動，快啲去其他分頁探索啦！</p>
                            }
                            else
                            {
                                @foreach (var log in _actionLogs)
                                {
                                    <div class="log-item">@log</div>
                                }
                            }
                        </div>
                    }
                    else if (_activeTab == "career")
                    {
                        <h4 class="section-title">💼 學習與工作選項 Education & Career</h4>
                        <div class="action-grid">
                            <!-- Childhood Actions (<18) -->
                            @if (Session.State.Age < 18)
                            {
                                @if (Session.State.HasFlag("dropped_out"))
                                {
                                    <div class="action-card" style="grid-column: span 2;">
                                        <div class="action-card-header">
                                            <span class="action-card-title">🏭 廠工打雜 Factory Work</span>
                                            <span class="action-card-limit">已退學</span>
                                        </div>
                                        <p class="action-card-desc">你被迫離開學校，每日喺工廠裝配玩具/塑膠花以賺錢幫補家用。</p>
                                        <p class="action-card-effects">健康 -3 · 壓力 +4 · 金錢 +$@FormatAmount(Session.ScaleMoney(1000))</p>
                                        <button type="button" class="primary-button action-button" disabled="@Session.IsBusy" @onclick="WorkHardAsync">💼 努力做工 Work</button>
                                    </div>
                                }
                                else
                                {
                                    <div class="action-card">
                                        <div class="action-card-header">
                                            <span class="action-card-title">努力學習 Study Hard</span>
                                            <span class="action-card-limit">@(Session.State.HasFlag("action_studied") ? "0/1" : "1/1")</span>
                                        </div>
                                        <p class="action-card-desc">努力溫習學校功課，為派位同考試打好基礎。</p>
                                        <p class="action-card-effects">學歷 +5 · 壓力 +3</p>
                                        <button type="button" class="primary-button action-button" disabled="@(Session.State.HasFlag("action_studied") || Session.IsBusy)" @onclick="StudyHardAsync">📚 溫書 Study</button>
                                    </div>

                                    <div class="action-card">
                                        <div class="action-card-header">
                                            <span class="action-card-title">報讀補習班 Attend Tutoring</span>
                                            @{
                                                var tutorCount = Session.State.FlagsSet.Count(f => f.StartsWith("action_tutor_", StringComparison.Ordinal));
                                                var remainingTutors = 2 - tutorCount;
                                            }
                                            <span class="action-card-limit">@remainingTutors/2</span>
                                        </div>
                                        <p class="action-card-desc">參加名師補習班，全面練習試題以取得優異成績。</p>
                                        <p class="action-card-effects cost">學歷 +10 · 壓力 +1 · 金錢 -$@FormatAmount(Session.ScaleMoney(2000))</p>
                                        <button type="button" class="primary-button action-button" disabled="@(remainingTutors <= 0 || Session.State.Stats.Money < Session.ScaleMoney(2000) || Session.IsBusy)" @onclick="AttendTutoringAsync">✏️ 補習 Tutor</button>
                                    </div>

                                    <div class="action-card">
                                        <div class="action-card-header">
                                            <span class="action-card-title">玩耍打機 Play Games</span>
                                            @{
                                                var playCount = Session.State.FlagsSet.Count(f => f.StartsWith("action_play_", StringComparison.Ordinal));
                                                var remainingPlays = 2 - playCount;
                                            }
                                            <span class="action-card-limit">@remainingPlays/2</span>
                                        </div>
                                        <p class="action-card-desc">放學後打機或買玩具玩耍，極大放鬆心情。</p>
                                        <p class="action-card-effects">健康 +2 · 壓力 -5 · 親情 -1</p>
                                        <button type="button" class="primary-button action-button" disabled="@(remainingPlays <= 0 || Session.IsBusy)" @onclick="PlayGamesAsync">🧸 玩耍 Play</button>
                                    </div>

                                    <div class="action-card">
                                        <div class="action-card-header">
                                            <span class="action-card-title">索取零用錢 Allowance</span>
                                            <span class="action-card-limit">@(Session.State.HasFlag("action_allowance") ? "0/1" : "1/1")</span>
                                        </div>
                                        <p class="action-card-desc">向爸媽扭計索取少量零用錢以購買玩具或零食。(成功率 70%)</p>
                                        <p class="action-card-effects">獲得零錢 (金額由家庭背景決定) (若失敗：壓力 +2)</p>
                                        <button type="button" class="primary-button action-button" disabled="@(Session.State.HasFlag("action_allowance") || Session.IsBusy)" @onclick="AskAllowanceAsync">💰 扭零用錢 Pocket Money</button>
                                    </div>
                                }
                            }
                            else
                            {
                                <!-- Adult Actions (18+) -->
                                @if (IsStudent())
                                {
                                    <div class="action-card">
                                        <div class="action-card-header">
                                            <span class="action-card-title">努力學習 Study Hard</span>
                                            <span class="action-card-limit">@(Session.State.HasFlag("action_studied") ? "0/1" : "1/1")</span>
                                        </div>
                                        <p class="action-card-desc">通宵達旦溫書，提升你嘅學力，但會增加壓力。</p>
                                        <p class="action-card-effects">學歷 +5 · 壓力 +3</p>
                                        <button type="button" class="primary-button action-button" disabled="@(Session.State.HasFlag("action_studied") || Session.IsBusy)" @onclick="StudyHardAsync">📚 溫書 Study</button>
                                    </div>

                                    <div class="action-card">
                                        <div class="action-card-header">
                                            <span class="action-card-title">報讀補習班 Attend Tutoring</span>
                                            @{
                                                var tutorCount = Session.State.FlagsSet.Count(f => f.StartsWith("action_tutor_", StringComparison.Ordinal));
                                                var remainingTutors = 2 - tutorCount;
                                            }
                                            <span class="action-card-limit">@remainingTutors/2</span>
                                        </div>
                                        <p class="action-card-desc">報讀升學補習班，全面提升考試能力與分數。</p>
                                        <p class="action-card-effects cost">學歷 +10 · 壓力 +1 · 金錢 -$@FormatAmount(Session.ScaleMoney(2000))</p>
                                        <button type="button" class="primary-button action-button" disabled="@(remainingTutors <= 0 || Session.State.Stats.Money < Session.ScaleMoney(2000) || Session.IsBusy)" @onclick="AttendTutoringAsync">✏️ 補習 Tutor</button>
                                    </div>
                                }

                                @if (IsWorker())
                                {
                                    <div class="action-card">
                                        <div class="action-card-header">
                                            <span class="action-card-title">努力工作 Work Hard</span>
                                            <span class="action-card-limit">@(Session.State.HasFlag("action_worked") ? "0/1" : "1/1")</span>
                                        </div>
                                        <p class="action-card-desc">努力加班工作，獲得老細賞識，爭取表現花紅。</p>
                                        <p class="action-card-effects">聲望 +3 · 壓力 +4 · 金錢 +$@FormatAmount(Session.ScaleMoney(1500))</p>
                                        <button type="button" class="primary-button action-button" disabled="@(Session.State.HasFlag("action_worked") || Session.IsBusy)" @onclick="WorkHardAsync">💼 OT加班 Work</button>
                                    </div>
                                }
                            }

                            @if (Session.State.Age >= 18)
                            {
                                var chosenTrack = Session.GetChosenCareerTrack();
                                @if (chosenTrack is null)
                                {
                                    <div class="action-card" style="grid-column: span 2;">
                                        <div class="action-card-header">
                                            <span class="action-card-title">求職面試 Job Applications</span>
                                        </div>
                                        <p class="action-card-desc">揀返份長工去面試，你嘅學歷同聲望會影響面試成功率；成功先至正式入職。</p>
                                        <div class="country-selector">
                                            @foreach (var track in Session.GetAvailableCareerTracks())
                                            {
                                                <button type="button" class="primary-button" style="min-height:36px;" disabled="@(!track.Eligible || Session.State.HasFlag("action_job_apply") || Session.IsBusy)" @onclick="() => ChooseCareerAsync(track.Id)" title="@(track.Eligible ? "" : $"需要學歷 ≥ {track.EduRequirement}")">
                                                    @track.Name @(track.Eligible ? "" : $"(需學歷≥{track.EduRequirement})")
                                                </button>
                                            }
                                        </div>
                                        @if (Session.State.HasFlag("action_job_apply"))
                                        {
                                            <p style="font-size:0.75rem; color:var(--text-secondary); margin-top:8px;">今年已經面試過，下一年先可以再試！</p>
                                        }
                                    </div>
                                }
                                else
                                {
                                    var trackInfo = Session.GetAvailableCareerTracks().FirstOrDefault(t => t.Id == chosenTrack);
                                    var careerLevel = Session.GetCareerLevel();
                                    var careerRank = HKLifeSim.Web.Services.GameSessionService.CareerRankLabel(careerLevel);
                                    var employer = Session.GetCurrentEmployer();
                                    <div class="action-card" style="grid-column: span 2;">
                                        <div class="action-card-header">
                                            <span class="action-card-title">💼 @(trackInfo.Name ?? chosenTrack)</span>
                                            <span class="action-card-limit">@careerRank (Lv.@careerLevel)</span>
                                        </div>
                                        <p class="action-card-desc">@(employer is not null ? $"僱主：{employer} · " : "")返工搵真銀，年資同表現愈高，人工同晉升機會愈大。</p>
                                        <p class="action-card-effects">聲望 +3 · 壓力 +5 · 金錢 (隨年資遞增)</p>
