@code {
    private string _activeTab = "home";
    private List<string> _actionLogs = [];
    private string? _actionFeedback;
    private bool _showCareerSwitcher;
    private string? _expandedNpcProfile;

    // Friend Share System Fields
    private string _shareCodeInput = string.Empty;
    private string? _friendFeedback;
    
    // Milestones Exam overlay state
    private string? _activeMilestone;

    // Exam Trivia States
    private bool _showExamTrivia = false;
    private int _triviaQ1Answer = -1;
    private int _triviaQ2Answer = -1;
    private string? _triviaError;

    private bool IsStreamSelectionRequired => Session.State is not null && Session.State.Age == 15 && !Session.State.HasFlag("dropped_out") && !Session.State.HasFlag("stream_science") && !Session.State.HasFlag("stream_business") && !Session.State.HasFlag("stream_arts");
    
    private bool IsCollegeSelectionRequired => Session.State is not null && Session.State.HasFlag("college_student") && !Session.State.HasFlag("college_asso") && !Session.State.HasFlag("college_hd");

    protected override void OnInitialized()
    {
        if (Session.State is null)
        {
            Nav.NavigateTo("/");
            return;
        }

        Session.Changed += OnSessionChanged;
        
        // Populate existing action logs if state has records
        _actionLogs.Clear();
        
        CheckMilestone();
    }

    private void CheckMilestone()
    {
        if (Session.MilestoneMessage is not null)
        {
            _activeMilestone = Session.MilestoneMessage;
            Session.MilestoneMessage = null;
        }
    }

    private void ClearMilestone()
    {
        _activeMilestone = null;
        StateHasChanged();
    }

    private string TranslateFlag(string flag)
    {
        return flag switch
        {
            "university_student" => "🎓 本地大學生",
            "overseas_student" => "✈️ 海外留學生",
            "early_worker" => "💼 職場打工仔",
            "dropped_out" => "❌ 中途退學",
            "has_partner" => "💖 戀愛中 (出Pool)",
            "married" => "💍 已婚",
            "divorced" => "💔 離咗婚",
            "homeowner" => "🏡 業主",
            "home_tonglau" => "🏚️ 唐樓/公屋業主",
            "home_private" => "🏢 私人屋苑業主",
            "home_luxury" => "🏰 半山豪宅業主",
            "emigrated" => "✈️ 已移民海外",
            "emigrated_UK" => "🇬🇧 定居英國",
            "emigrated_AUSTRALIA" => "🇦🇺 定居澳洲",
            "emigrated_CANADA" => "🇨🇦 定居加拿大",
            "emigrated_US" => "🇺🇸 定居美國",
            "stream_science" => "🧪 選修：理科 Science",
            "stream_business" => "📈 選修：商科 Business",
            "stream_arts" => "📜 選修：文科 Arts",
            "college_asso" => "🎨 大專：副學士 Asso",
            "college_hd" => "💻 大專：高級文憑 HD",
            _ => flag
        };
    }

    private bool IsStudent()
    {
        if (Session.State is null) return false;
        return Session.State.Age < 23 && (Session.State.HasFlag("university_student") || Session.State.HasFlag("overseas_student") || Session.State.HasFlag("college_student"));
    }

    private bool IsWorker()
    {
        if (Session.State is null) return false;
        return Session.State.Age >= 18 && !Session.State.HasFlag("university_student") && !Session.State.HasFlag("overseas_student") && !Session.State.HasFlag("college_student");
    }

    private bool IsModernEra()
    {
        if (Session.Era is null) return false;
        return Session.Era.EraId == "2000s" || Session.Era.EraId == "2024plus";
    }

    private string FormatAmount(int amount)
    {
        return $"{amount:N0}";
    }

    private async Task SelectChoiceAsync(string choiceId)
    {
        _actionFeedback = null;
        await Session.SelectChoiceAsync(choiceId);

        if (Session.State is { IsAlive: false })
        {
            Nav.NavigateTo("/obituary");
        }
    }

    private async Task AdvanceYearAsync()
    {
        _actionFeedback = null;

        // If at age 17 and has not taken exam trivia questions, intercept to display it
        if (Session.State is not null && Session.State.Age == 17 && !Session.State.HasFlag("dropped_out") && !_showExamTrivia)
        {
            _showExamTrivia = true;
            _triviaQ1Answer = -1;
            _triviaQ2Answer = -1;
            _triviaError = null;
            return;
        }

        _actionLogs.Clear(); // reset action logs for the new year
        await Session.AdvanceYearAsync();

        if (Session.State is { IsAlive: false })
        {
            Nav.NavigateTo("/obituary");
        }
        else
        {
            CheckMilestone();
            if (Session.WorldNewsMessage is not null)
            {
                AddLog($"📰 {Session.WorldNewsMessage}");
            }
        }
    }

    private async Task SubmitExamTrivia()
    {
        if (_triviaQ1Answer == -1 || _triviaQ2Answer == -1)
        {
            _triviaError = "請完成所有試題！";
            return;
        }

        var correctCount = (_triviaQ1Answer == 0 ? 1 : 0) + (_triviaQ2Answer == 0 ? 1 : 0);
        if (correctCount == 1)
        {
            Session.State?.SetFlag("exam_bonus_1");
        }
        else if (correctCount == 2)
        {
            Session.State?.SetFlag("exam_bonus_2");
        }

        _showExamTrivia = false;
        _triviaError = null;

        // Proceed to year advancement
        _actionLogs.Clear();
        await Session.AdvanceYearAsync();

        if (Session.State is { IsAlive: false })
        {
            Nav.NavigateTo("/obituary");
        }
        else
        {
            CheckMilestone();
        }
    }

    private void ChooseStream(string stream)
    {
        if (Session.State is null) return;
        Session.State.SetFlag($"stream_{stream}");
        var streamName = stream switch {
            "science" => "理科 Science",
            "business" => "商科 Business",
            "arts" => "文科 Arts",
            _ => "選修科"
        };
        AddLog($"你選擇咗選修：{streamName}，開始衝刺公開試！");
        StateHasChanged();
    }

    private void ChooseCollege(string path)
    {
        if (Session.State is null) return;
        Session.State.SetFlag($"college_{path}");
        var pathName = path == "asso" ? "副學士 Asso" : "高級文憑 HD";
        AddLog($"你選擇就讀：{pathName}，準備爭取銜接學位！");
        StateHasChanged();
    }

    private async Task StudyHardAsync()
    {
        _actionFeedback = await Session.StudyHardAsync();
        AddLog(_actionFeedback);
    }

    private async Task AttendTutoringAsync()
    {
        _actionFeedback = await Session.AttendTutoringAsync();
        AddLog(_actionFeedback);
    }

    private async Task WorkHardAsync()
    {
        _actionFeedback = await Session.WorkHardAsync();
        AddLog(_actionFeedback);
    }

    private async Task ChooseCareerAsync(string trackId)
    {
        _actionFeedback = await Session.ChooseCareerAsync(trackId);
        _showCareerSwitcher = false;
        AddLog(_actionFeedback);
    }

    private async Task GoToCareerJobAsync()
    {
        _actionFeedback = await Session.GoToCareerJobAsync();
        AddLog(_actionFeedback);
    }

    private async Task GigWorkAsync()
    {
        _actionFeedback = await Session.GigWorkAsync();
        AddLog(_actionFeedback);
    }

    private async Task PlayGamesAsync()
    {
        _actionFeedback = await Session.PlayGamesAsync();
        AddLog(_actionFeedback);
    }

    private async Task AskAllowanceAsync()
    {
        _actionFeedback = await Session.AskAllowanceAsync();
        AddLog(_actionFeedback);
    }

    private async Task SpendFamilyTimeAsync()
    {
        _actionFeedback = await Session.SpendFamilyTimeAsync();
        AddLog(_actionFeedback);
    }

    private async Task BuyFamilyGiftAsync()
    {
