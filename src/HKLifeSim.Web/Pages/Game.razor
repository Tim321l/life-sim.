                                        <button type="button" class="primary-button action-button" disabled="@(Session.State.HasFlag("action_pro_musician") || Session.IsBusy)" @onclick="ProfessionalMusicianAsync">🎤 職業演出 Perform</button>
                                    </div>
                                }

                                @if (Session.IsSportsMaster())
