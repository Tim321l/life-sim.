                            <button type="button" class="primary-button" style="width:100%; min-height:44px;" disabled="@(Session.State.HasFlag("action_make_friend") || Session.IsBusy)" @onclick="MakeNpcFriendAsync">🤝 識新朋友 Make a Friend</button>
                        </div>

                        @foreach (var categoryGroup in Session.GetNpcFriends().GroupBy(n => n.Category))
                        {
