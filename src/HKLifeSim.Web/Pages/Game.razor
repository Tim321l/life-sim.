                                        }
                                        else
                                        {
                                            <button type="button" class="primary-button action-btn" disabled="@(Session.State.HasFlag("homeowner") || Session.State.Stats.Money < (int)(Session.Era?.AverageHousePrice * 0.5m ?? 0m) || Session.IsBusy)" @onclick='() => BuyPropertyAsync("tonglau")'>購買 Buy</button>
                                        }
                                    </div>
                                </div>

                                <!-- Tier 2 Property: Private Apartment -->
                                <div class="property-item">
                                    <div class="property-details">
                                        <div class="property-name">市區私人住宅 Private Apartment</div>
