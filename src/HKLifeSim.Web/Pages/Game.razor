    {
        var code = Session.ExportShareCode();
        _friendFeedback = $"複製成功！我嘅代碼為: {code}";
    }

    private void AddLog(string msg)
    {
        if (Session.State is null) return;
        if (msg.Contains("唔夠錢") || msg.Contains("已經") || msg.Contains("無效狀態") || msg.Contains("夠多啦") || msg.Contains("適可而止") || msg.Contains("強求"))
        {
            // Do not log failure actions into history
            return;
        }
        _actionLogs.Insert(0, $"{Session.State.CurrentYear}年 ({Session.State.Age}歲): {msg}");
        StateHasChanged();
    }

