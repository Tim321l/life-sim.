@using HKLifeSim.Core.Domain

<div class="radar-chart-container glass-panel" style="padding: 16px; text-align: center; margin-bottom: 16px;">
    <h3 class="section-title" style="margin-bottom: 12px; font-size: 1rem; letter-spacing: 0.05em; display: flex; align-items: center; justify-content: center; gap: 8px;">
        📊 狀態圖表 Stats Chart
    </h3>
    <svg viewBox="0 0 320 280" style="width: 100%; max-height: 220px; filter: drop-shadow(0 0 8px rgba(0, 242, 254, 0.15));">
        <!-- Definitions for Gradients -->
        <defs>
            <radialGradient id="radarGlow" cx="50%" cy="50%" r="50%">
                <stop offset="0%" stop-color="#00f2fe" stop-opacity="0.35" />
                <stop offset="100%" stop-color="#4facfe" stop-opacity="0.05" />
            </radialGradient>
        </defs>

        <!-- Grid Rings -->
        @for (int r = 20; r <= 100; r += 20)
        {
            <polygon points="@GetPointsString(r, r, r, r, r)" 
                     fill="none" 
                     stroke="rgba(255, 255, 255, 0.08)" 
                     stroke-width="1" />
        }

        <!-- Axis Lines -->
        @for (int i = 0; i < 5; i++)
        {
            var endPoint = GetVertexPoint(i, 100);
            <line x1="150" y1="140" x2="@endPoint.X" y2="@endPoint.Y" 
                  stroke="rgba(255, 255, 255, 0.12)" 
                  stroke-width="1" 
                  stroke-dasharray="2,2" />
        }

        <!-- Labels -->
        <text x="150" y="20" text-anchor="middle" fill="#a0aec0" font-size="11" font-weight="bold">🧘 靜心 @(100 - Stats.Stress)</text>
        <text x="278" y="102" text-anchor="start" fill="#a0aec0" font-size="11" font-weight="bold">📚 學修 @Stats.Education</text>
        <text x="228" y="248" text-anchor="start" fill="#a0aec0" font-size="11" font-weight="bold">🏆 聲望 @Stats.Reputation</text>
        <text x="92" y="248" text-anchor="end" fill="#a0aec0" font-size="11" font-weight="bold">👪 親情 @Stats.FamilyBond</text>
        <text x="42" y="102" text-anchor="end" fill="#a0aec0" font-size="11" font-weight="bold">❤️ 健康 @Stats.Health</text>

        <!-- Data Area Polygon -->
        <polygon points="@GetPointsString(100 - Stats.Stress, Stats.Education, Stats.Reputation, Stats.FamilyBond, Stats.Health)" 
                 fill="url(#radarGlow)" 
                 stroke="#00f2fe" 
                 stroke-width="2" 
                 style="transition: points 0.5s ease-in-out;" />

        <!-- Data Vertices Dots -->
        @for (int i = 0; i < 5; i++)
        {
            var val = GetStatValue(i);
            var pt = GetVertexPoint(i, val);
            <circle cx="@pt.X" cy="@pt.Y" r="4" fill="#4facfe" stroke="#fff" stroke-width="1.5" />
        }
    </svg>
</div>

@code {
    [Parameter]
    public required StatBlock Stats { get; set; }

    private int GetStatValue(int index)
    {
        return index switch
        {
            0 => 100 - Stats.Stress,
            1 => Stats.Education,
            2 => Stats.Reputation,
            3 => Stats.FamilyBond,
            4 => Stats.Health,
            _ => 0
        };
    }

    private string GetPointsString(int v0, int v1, int v2, int v3, int v4)
    {
        var p0 = GetVertexPoint(0, v0);
        var p1 = GetVertexPoint(1, v1);
        var p2 = GetVertexPoint(2, v2);
        var p3 = GetVertexPoint(3, v3);
        var p4 = GetVertexPoint(4, v4);

        return $"{p0.X:F1},{p0.Y:F1} {p1.X:F1},{p1.Y:F1} {p2.X:F1},{p2.Y:F1} {p3.X:F1},{p3.Y:F1} {p4.X:F1},{p4.Y:F1}";
    }

    private (double X, double Y) GetVertexPoint(int index, int value)
    {
        // Angles: -90, -18, 54, 126, 198
        double angleRad = (-90 + index * 72) * Math.PI / 180.0;
        double radius = Math.Clamp(value, 0, 100);

        double x = 150 + radius * Math.Cos(angleRad);
        double y = 140 + radius * Math.Sin(angleRad);

        return (x, y);
    }
}
