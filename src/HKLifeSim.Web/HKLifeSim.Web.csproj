<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <!-- Vercel (and most plain static hosts) don't perform Blazor's expected Brotli/gzip
         content negotiation, so the browser can end up fetching a compressed .wasm as if it
         were raw bytes and fail to instantiate it. Publish only the uncompressed assets. -->
    <CompressionEnabled>false</CompressionEnabled>
    <!-- CA1812: Services/components here are constructed by the DI container and Blazor's
         Router, which the analyzer can't see. -->
    <NoWarn>$(NoWarn);CA1812</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\HKLifeSim.Core\HKLifeSim.Core.csproj" />
  </ItemGroup>

  <!-- Blazor's static web asset discovery scans wwwroot/ at build time, before any
       CopyToOutputDirectory step runs, so era/event JSON must be physically present under
       wwwroot/data/ (not just linked into the output dir) to be served by the dev server
       or published output. Mirror the repo's single source of truth (data/) in here. -->
  <Target Name="CopyGameContentIntoWwwroot" BeforeTargets="BeforeBuild;DispatchToInnerBuilds">
    <ItemGroup>
      <GameContentJson Include="..\..\data\**\*.json" />
    </ItemGroup>
    <Copy
      SourceFiles="@(GameContentJson)"
      DestinationFolder="$(MSBuildProjectDirectory)\wwwroot\data"
      SkipUnchangedFiles="true" />
  </Target>

  <!-- Same reasoning as CopyGameContentIntoWwwroot above, applied to the shared Digivice sprite
       assets: they must be physically present under wwwroot/ before Blazor's static asset
       discovery runs. %(RecursiveDir) is needed here (unlike the data/ copy) to preserve the
       icons/ subfolder. -->
  <Target Name="CopyDigiviceAssetsIntoWwwroot" BeforeTargets="BeforeBuild;DispatchToInnerBuilds">
    <ItemGroup>
      <DigiviceAsset Include="..\..\assets\sprites\**\*" />
    </ItemGroup>
    <Copy
      SourceFiles="@(DigiviceAsset)"
      DestinationFolder="$(MSBuildProjectDirectory)\wwwroot\sprites\%(RecursiveDir)"
      SkipUnchangedFiles="true" />
  </Target>

</Project>
