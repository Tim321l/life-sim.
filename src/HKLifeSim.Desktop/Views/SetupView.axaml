<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HKLifeSim.Desktop.ViewModels"
             xmlns:svc="using:HKLifeSim.Desktop.Services"
             xmlns:conv="using:Avalonia.Data.Converters"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="720"
             x:Class="HKLifeSim.Desktop.Views.SetupView"
             x:DataType="vm:SetupViewModel">

    <ScrollViewer>
        <StackPanel Margin="32" Spacing="16" MaxWidth="820" HorizontalAlignment="Center">

            <TextBlock Text="香港人生模擬器" FontSize="32" FontWeight="Bold" HorizontalAlignment="Center" />
            <TextBlock Text="揀一個年代，開展你嘅香港人生" FontSize="14" Opacity="0.7" HorizontalAlignment="Center" Margin="0,0,0,16" />

            <ListBox ItemsSource="{Binding EraCards}"
                     SelectedItem="{Binding SelectedEra}"
                     SelectionMode="Single"
                     Background="Transparent">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="svc:EraCardInfo">
                        <Border Classes="eraCard" Width="360" Margin="6"
                                BorderBrush="Transparent"
                                Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
                            <StackPanel Spacing="4">
                                <TextBlock Text="{Binding DisplayName}" FontSize="18" FontWeight="Bold" />
                                <TextBlock Text="{Binding YearRange}" FontSize="12" Opacity="0.7" />
                                <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock Text="{Binding SelectedEra.DisplayName, StringFormat='已揀選：{0}'}" FontWeight="Bold" Margin="0,8,0,0" />

            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <TextBlock Text="種子 (留空 = 隨機):" VerticalAlignment="Center" />
                <TextBox Text="{Binding SeedText}" Width="160" />
            </StackPanel>

            <Button Content="開始新生活" Command="{Binding StartNewLifeCommand}" HorizontalAlignment="Left" Padding="20,10" />

            <StackPanel IsVisible="{Binding CanContinueLastSave}" Spacing="8" Margin="0,16,0,0">
                <Separator />
                <Button Content="繼續上次" Command="{Binding ContinueLastSaveCommand}" HorizontalAlignment="Left" Padding="20,10" />
            </StackPanel>

            <StackPanel IsVisible="{Binding HasCompletedLineage}" Spacing="8" Margin="0,16,0,0">
                <Separator />
                <CheckBox Content="繼承模式：以上一代嘅家族傳承開展新生活" IsChecked="{Binding UseLegacyMode}" />
            </StackPanel>

            <TextBlock Text="{Binding ErrorMessage}"
                       Foreground="Red"
                       IsVisible="{Binding ErrorMessage, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />

        </StackPanel>
    </ScrollViewer>

</UserControl>
